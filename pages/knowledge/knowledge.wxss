/* pages/knowledge/knowledge.wxss */

/* 知识点标签页 */
.knowledge-tabs {
  display: flex;
  overflow-x: auto;
  padding: 10px 0;
  white-space: nowrap;
}

.knowledge-tabs::-webkit-scrollbar {
  display: none;
}

.tab-item {
  padding: 8px 16px;
  margin: 0 5px;
  border-radius: 20px;
  font-size: 14px;
  color: #666666;
  background-color: #f0f0f0;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tab-item:first-child {
  margin-left: 15px;
}

.tab-item:last-child {
  margin-right: 15px;
}

.tab-item.active {
  background-color: #667eea;
  color: #ffffff;
}

/* 知识点列表 */
.knowledge-list {
  padding: 10px 0;
}

.knowledge-item {
  display: flex;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color 0.3s ease;
}

.knowledge-item:last-child {
  border-bottom: none;
}

.knowledge-item:active {
  background-color: #f5f5f5;
}

.knowledge-number {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 15px;
  flex-shrink: 0;
}

.knowledge-content {
  flex: 1;
}

.knowledge-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 5px;
}

.knowledge-desc {
  font-size: 14px;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.knowledge-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.tag {
  padding: 3px 8px;
  background-color: #e8f0fe;
  color: #667eea;
  font-size: 12px;
  border-radius: 10px;
}

/* 学习进度 */
.progress-content {
  padding: 15px;
}

.progress-item {
  margin-bottom: 20px;
}

.progress-item:last-child {
  margin-bottom: 0;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.progress-percent {
  font-size: 14px;
  font-weight: 500;
  color: #667eea;
}

.progress-bar {
  width: 100%;
  height: 10px;
  background-color: #f0f0f0;
  border-radius: 5px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 5px;
  transition: width 0.5s ease;
}