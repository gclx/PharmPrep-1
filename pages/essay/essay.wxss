/* pages/essay/essay.wxss */

/* 科目标签页 */
.subject-tabs {
  display: flex;
  overflow-x: auto;
  padding: 10px 0;
  white-space: nowrap;
}

.subject-tabs::-webkit-scrollbar {
  display: none;
}

.tab-item {
  padding: 8px 16px;
  margin: 0 5px;
  border-radius: 20px;
  font-size: 14px;
  color: #666666;
  background-color: #f0f0f0;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tab-item:first-child {
  margin-left: 15px;
}

.tab-item:last-child {
  margin-right: 15px;
}

.tab-item.active {
  background-color: #667eea;
  color: #ffffff;
}

/* 大题头部 */
.essay-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.essay-count {
  font-size: 14px;
  color: #666666;
}

.essay-filter {
  position: relative;
}

.filter-btn {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  font-size: 14px;
  color: #666666;
  background-color: #ffffff;
}

.filter-arrow {
  font-size: 10px;
  margin-left: 5px;
}

/* 大题列表 */
.essay-list {
  padding: 10px 0;
}

.essay-item {
  display: flex;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color 0.3s ease;
}

.essay-item:last-child {
  border-bottom: none;
}

.essay-item:active {
  background-color: #f5f5f5;
}

.essay-number {
  font-size: 16px;
  font-weight: 600;
  color: #667eea;
  margin-right: 15px;
  min-width: 30px;
  text-align: right;
}

.essay-content {
  flex: 1;
}

.essay-question {
  font-size: 15px;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.essay-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.tag {
  padding: 3px 8px;
  background-color: #e8f0fe;
  color: #667eea;
  font-size: 12px;
  border-radius: 10px;
}