/* pages/trueExam/trueExam.wxss */

/* 筛选器 */
.exam-filter {
  display: flex;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.filter-section {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.filter-label {
  font-size: 12px;
  color: #999999;
  margin-bottom: 5px;
}

.filter-value {
  padding: 8px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  font-size: 14px;
  color: #333333;
  background-color: #ffffff;
}

/* 真题列表 */
.exam-list {
  padding: 10px 0;
}

.exam-item {
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color 0.3s ease;
}

.exam-item:last-child {
  border-bottom: none;
}

.exam-item:active {
  background-color: #f5f5f5;
}

.exam-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.exam-name {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  flex: 1;
  margin-right: 10px;
}

.exam-year {
  font-size: 14px;
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
  padding: 3px 8px;
  border-radius: 10px;
}

.exam-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.exam-subject {
  font-size: 14px;
  color: #666666;
}

.exam-status {
  display: flex;
  align-items: center;
}

.new-tag {
  font-size: 12px;
  color: #e74c3c;
  background-color: rgba(231, 76, 60, 0.1);
  padding: 2px 6px;
  border-radius: 10px;
}

.exam-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.exam-download {
  font-size: 12px;
  color: #999999;
}

.exam-arrow {
  font-size: 20px;
  color: #cccccc;
  margin-left: 10px;
}