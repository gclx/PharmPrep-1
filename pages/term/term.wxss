/* pages/term/term.wxss */

/* 名词解释标签页 */
.term-tabs {
  display: flex;
  overflow-x: auto;
  padding: 10px 0;
  white-space: nowrap;
}

.term-tabs::-webkit-scrollbar {
  display: none;
}

.tab-item {
  padding: 8px 16px;
  margin: 0 5px;
  border-radius: 20px;
  font-size: 14px;
  color: #666666;
  background-color: #f0f0f0;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tab-item:first-child {
  margin-left: 15px;
}

.tab-item:last-child {
  margin-right: 15px;
}

.tab-item.active {
  background-color: #667eea;
  color: #ffffff;
}

/* 名词解释卡片 */
.term-card {
  padding: 20px;
  background-color: #ffffff;
  border-radius: 12px;
}

.term-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.term-index {
  font-size: 14px;
  color: #666666;
}

.term-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  font-size: 24px;
  margin-left: 15px;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.action-btn:active {
  transform: scale(0.9);
}

/* 名词解释内容 */
.term-content {
  margin-bottom: 25px;
}

.term-word {
  font-size: 24px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 15px;
  text-align: center;
}

.term-explanation {
  font-size: 16px;
  line-height: 1.6;
  color: #666666;
  text-align: justify;
  padding: 0 10px;
}

/* 导航按钮 */
.term-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20px;
  border-top: 1px solid #f0f0f0;
}

.nav-btn {
  padding: 10px 20px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
}

.nav-btn.prev {
  background-color: #f0f0f0;
  color: #666666;
}

.nav-btn.next {
  background-color: #667eea;
  color: #ffffff;
}

.nav-btn:active {
  transform: scale(0.95);
}

/* 学习统计 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
  padding: 15px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background-color: #f8f9fa;
  border-radius: 12px;
}

.stat-value {
  font-size: 28px;
  font-weight: 600;
  color: #667eea;
  margin-bottom: 5px;
}

.stat-label {
  font-size: 14px;
  color: #666666;
}