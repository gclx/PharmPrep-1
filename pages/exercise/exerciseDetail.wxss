/* pages/exercise/exerciseDetail.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7fa;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.progress-info {
  font-size: 32rpx;
}

.current-index {
  color: #3498db;
  font-weight: bold;
  font-size: 40rpx;
}

.total-count {
  color: #999999;
  font-size: 28rpx;
}

.right-actions {
  display: flex;
  gap: 30rpx;
}

.action-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666666;
}

.action-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.question-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
  box-sizing: border-box;
}

.question-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.question-header {
  margin-bottom: 40rpx;
}

.question-type {
  display: inline-block;
  background-color: #e8f4fd;
  color: #3498db;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.question-title {
  font-size: 34rpx;
  color: #333333;
  line-height: 1.6;
  font-weight: 500;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.options-list.horizontal {
  flex-direction: row;
  gap: 30rpx;
}

.options-list.horizontal .option-item {
  flex: 1;
  justify-content: center;
  text-align: center;
  padding: 30rpx 0;
}

.options-list.horizontal .option-label {
  width: auto;
  font-size: 34rpx;
}

.options-list.horizontal .option-content {
  flex: 0;
}

.option-item {
  display: flex;
  padding: 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.option-item.selected {
  background-color: #e8f4fd;
  border-color: #3498db;
}

.option-item.correct {
  background-color: #e8fbf0;
  border-color: #2ecc71;
}

.option-item.wrong {
  background-color: #fdeded;
  border-color: #e74c3c;
}

.option-label {
  width: 60rpx;
  font-weight: bold;
  color: #666666;
  font-size: 32rpx;
}

.option-item.selected .option-label {
  color: #3498db;
}

.option-item.correct .option-label {
  color: #2ecc71;
}

.option-item.wrong .option-label {
  color: #e74c3c;
}

.option-content {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
}

.analysis-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #eeeeee;
}

.result-row {
  display: flex;
  gap: 40rpx;
  margin-bottom: 30rpx;
}

.result-item {
  font-size: 30rpx;
  color: #666666;
}

.value {
  font-weight: bold;
  margin-left: 10rpx;
}

.correct-text {
  color: #2ecc71;
}

.wrong-text {
  color: #e74c3c;
}

.analysis-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #3498db;
}

.analysis-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: justify;
}

.bottom-bar {
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
}

.btn-wrapper.left {
  justify-content: flex-start;
}

.btn-wrapper.center {
  justify-content: center;
}

.btn-wrapper.right {
  justify-content: flex-end;
}

.nav-btn {
  font-size: 30rpx;
  color: #666666;
  padding: 16rpx 20rpx;
  white-space: nowrap;
}

.nav-btn.disabled {
  color: #cccccc;
}

.action-btn {
  background-color: #3498db;
  color: #ffffff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
  white-space: nowrap;
}
